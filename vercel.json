{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "bash scripts/vercel-build.sh",
  "regions": ["bom1"],
  "functions": {
    "app.py": {
      "maxDuration": 300,
      "excludeFiles": "{backend/tests/**,backend/.venv/**,backend/uv.lock,docs/**,frontend/node_modules/**,frontend/src/**,frontend/public/**,frontend/*.json,frontend/*.ts,frontend/*.yaml,scripts/**,.claude/**,**/*.test.*,**/__pycache__/**}"
    }
  }
}
