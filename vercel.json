{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "bash scripts/vercel-build.sh",
  "regions": [
    "bom1"
  ],
  "functions": {
    "app.py": {
      "maxDuration": 300,
      "excludeFiles": "{backend/tests/**,backend/.venv/**,backend/uv.lock,docs/**,public/**,frontend/node_modules/**,frontend/src/**,frontend/public/**,frontend/*.json,frontend/*.ts,frontend/*.yaml,scripts/**,.claude/**,**/*.test.*,**/__pycache__/**}"
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/((?!api/).*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; manifest-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; object-src 'none'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Cross-Origin-Resource-Policy",
          "value": "same-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/navall",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/cron/navall-continue",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/history",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/snapshot",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/watchdog",
      "schedule": "0 13 * * *"
    }
  ]
}
